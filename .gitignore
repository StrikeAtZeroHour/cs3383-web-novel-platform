# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Coverage artefacts (generated by `coverage run/lcov/html`) ---
# NOTE: src/.coveragerc IS tracked (it is the coverage configuration).
# These outputs are regenerated by the VS Code task "test: coverage report + lcov".
.coverage
.coverage.*
coverage.json
coverage.lcov
lcov.info
coverage.xml
htmlcov/

# --- Django ---
# NOTE: src/db.sqlite3 IS tracked on purpose: it ships the seeded demo data
# (users alice/bob + sample novels) so the project runs right after cloning.
# Regenerate it any time with `manage.py migrate` + `manage.py seed_demo`.
db.sqlite3-journal
*.log
media/
staticfiles/

# --- i18n compiled files (generated by compilemessages) ---
# NOTE: locale/zh_Hant/LC_MESSAGES/django.po IS tracked. After cloning, run
#   cd src
#   $env:Path += ";..\.venv\Scripts\gettext\bin"
#   ..\.venv\Scripts\python.exe manage.py compilemessages
# Otherwise the Chinese interface silently falls back to English.
*.mo

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Secrets: contains a plaintext API key ---
opencode.json

# --- Virtual environment ---
.venv/

# --- Local environment file (copy from .env.example) ---
# .env holds only per-machine paths (DJANGO_SETTINGS_MODULE / PYTHONPATH),
# no secrets, but each developer keeps their own; .env.example IS tracked.
.env

# --- Coverage artefacts (generated) ---
.coverage
.coverage.*
coverage.json
coverage.lcov
coverage.xml
htmlcov/
