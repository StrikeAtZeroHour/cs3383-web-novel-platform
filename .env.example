# Copy this file to `.env` (same directory) before opening VS Code.
# Read by the Python extension (python.envFile) and pytest-django.
# No real secrets belong in a committed file; these are development defaults.
DJANGO_SETTINGS_MODULE=config.settings
PYTHONPATH=src
DJANGO_DEBUG=True
# In production set DJANGO_DEBUG=False and provide a strong DJANGO_SECRET_KEY.
# DJANGO_SECRET_KEY=change-me
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
